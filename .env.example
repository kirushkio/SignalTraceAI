# SignalTrace AI — Server Environment Variables (Phase 3 Sponsor Integrations)
# Keep all credentials server-side. Never commit actual secret keys.

# ==============================================================================
# SPONSOR A: NVIDIA NEMOTRON
# Documented Endpoint: https://integrate.api.nvidia.com/v1/chat/completions
# Supported Model: nvidia/llama-3.1-nemotron-70b-instruct or nvidia/nemotron-4-340b-instruct
# ==============================================================================
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_TIMEOUT_MS=12000

# ==============================================================================
# SPONSOR B: ZETARIS DATA VIRTUALIZATION FABRIC
# Documented Endpoint: https://api.saas.enterprise.zetaris.com or tenant endpoint
# ==============================================================================
ZETARIS_API_URL=https://api.saas.enterprise.zetaris.com
ZETARIS_TENANT_ID=
ZETARIS_ID_TOKEN=
ZETARIS_REFRESH_TOKEN=
ZETARIS_TIMEOUT_MS=8000

# ==============================================================================
# SPONSOR C: METERLESS CONTEXT LAYER (H-MEM, Scout Intent, World Model)
# Local-first open-source architecture (github.com/meterless/meterless)
# ==============================================================================
METERLESS_ENABLED=true
METERLESS_STORAGE_MODE=local_persistent
METERLESS_HMEM_PATH=./data/meterless_hmem_state.json
METERLESS_WORLD_MODEL_PATH=./data/meterless_world_model.json
METERLESS_SCOUT_INTENT_CONFIDENCE_THRESHOLD=0.75

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
PORT=3001
NODE_ENV=development
